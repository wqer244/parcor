{
  "expo": {
    "name": "باركور العرب",
    "slug": "parcor",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060612"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parcor",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "نحتاج صلاحية المايك حتى تقدر تتكلم مع اللاعبين الآخرين بالغرفة."
      }
    },
    "android": {
      "package": "com.parcor",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#060612"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class io.agora.** {*;}\n-dontwarn io.agora.**\n-keep class com.google.android.exoplayer2.** {*;}\n-dontwarn com.google.android.exoplayer2.**\n-keep class expo.modules.** {*;}\n-keepclassmembers class expo.modules.** {*;}\n-dontwarn expo.modules.**\n-keep class org.unimodules.** {*;}\n-keepclassmembers class org.unimodules.** {*;}"
          }
        }
      ],
      "./plugins/withAbiFilters.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6dabf1ca-fe40-4fe1-99fb-214096a6349d"
      }
    }
  }
}
